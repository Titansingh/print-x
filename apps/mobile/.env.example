# Copy to .env.local for local development. Never commit real .env files.
# EXPO_PUBLIC_* values are embedded in the app bundle and readable by anyone
# with the app: NEVER put secrets, private keys, database credentials,
# service-role tokens or payment secrets here.

# Base URL of the separately maintained backend REST API.
# On a physical device, `localhost` is the phone itself. Use your development
# machine's LAN address (e.g. http://192.168.1.20:8080) or a tunnel URL.
EXPO_PUBLIC_API_URL=http://localhost:8080
