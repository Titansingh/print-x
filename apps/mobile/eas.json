{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8080"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "development-partner": {
      "extends": "development",
      "env": {
        "APP_VARIANT": "partner",
        "EXPO_PUBLIC_APP_VARIANT": "partner"
      }
    },
    "preview-partner": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "partner",
        "EXPO_PUBLIC_APP_VARIANT": "partner"
      }
    },
    "production-partner": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "partner",
        "EXPO_PUBLIC_APP_VARIANT": "partner"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
