# Copy to .env.local for local development. Never commit real .env files.
# VITE_* values are embedded in the public client bundle: NEVER put secrets,
# private keys, database credentials, service-role tokens or payment secrets here.

# Base URL of the separately maintained backend REST API.
VITE_API_URL=http://localhost:8080

# Development only: show isolated demo catalog data until the backend exists.
VITE_USE_DEMO_DATA=true
