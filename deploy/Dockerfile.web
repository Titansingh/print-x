# Builds one Vite web app (storefront | admin | partner) and serves it with nginx.
# Usage: docker build -f deploy/Dockerfile.web --build-arg APP=storefront .
FROM node:24.13.0-slim AS build
ARG APP
ARG VITE_API_URL
ARG VITE_USE_DEMO_DATA=false
ARG VITE_USE_DEMO_AUTH=false
ARG VITE_DEMO_ROLE
ENV VITE_API_URL=$VITE_API_URL \
    VITE_USE_DEMO_DATA=$VITE_USE_DEMO_DATA \
    VITE_USE_DEMO_AUTH=$VITE_USE_DEMO_AUTH \
    VITE_DEMO_ROLE=$VITE_DEMO_ROLE
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @platform/${APP} build

FROM nginx:1.27-alpine
ARG APP
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/${APP}/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
